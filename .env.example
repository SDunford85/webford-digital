# Copy to .env (for Next.js / drizzle-kit) AND .dev.vars (for wrangler preview)
# Never commit the real files.

# Neon → your project → Connect → "Pooled connection" string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

NEXT_PUBLIC_SITE_URL="http://localhost:3004"

# Admin site (/admin) — your password, and a long random string used to sign the login cookie
# (e.g. run:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())")
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_SESSION_SECRET="at-least-32-random-characters-here"

# Email alert for new enquiries (optional) — free account at resend.com → API Keys
RESEND_API_KEY=""
# Where alerts go, and who they come from. Until your domain is verified in Resend,
# leave ENQUIRY_EMAIL_FROM as onboarding@resend.dev and send to the email you signed up to Resend with.
ENQUIRY_EMAIL_TO="you@example.com"
ENQUIRY_EMAIL_FROM="Hexford Digital website <onboarding@resend.dev>"
