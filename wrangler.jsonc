{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webford-digital",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding required by OpenNext; must match "name" above
      "binding": "WORKER_SELF_REFERENCE",
      "service": "webford-digital"
    }
  ],
  // Keep variables added in the Cloudflare dashboard when a new build deploys
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://webford-digital.stephen-dunford.workers.dev"
  }
  // Secrets (DATABASE_URL, later ADMIN_PASSWORD, ADMIN_SESSION_SECRET, ANTHROPIC_API_KEY)
  // are NOT stored here. Add them in Cloudflare → Workers → webford-digital → Settings → Variables and secrets,
  // or with:  npx wrangler secret put <NAME>
}
